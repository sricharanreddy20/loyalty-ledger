# Copy to .env (git-ignored) and adjust if needed.
POSTGRES_USER=loyalty
POSTGRES_PASSWORD=loyalty
POSTGRES_DB=loyalty

# Host port for the Docker Postgres. 5433 avoids clashing with a local Postgres on 5432.
DB_PORT=5433

# Used by the generator loader and the backend when run on the host.
DATABASE_URL=postgresql://loyalty:loyalty@localhost:5433/loyalty
